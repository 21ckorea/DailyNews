ai:
  trend_top_n: 100
  request_delay: 1.0

categories:
  - name: "CategoryA"
    base_query: "MainTopicA"
    candidate_keywords: ["Keyword1", "Keyword2", "Keyword3"]
  - name: "CategoryB"
    base_query: "MainTopicB"
    candidate_keywords: ["KeywordX", "KeywordY"]

email:
  smtp_server: "smtp.gmail.com"
  smtp_port: 587
  sender_email: "your_email@gmail.com"
  sender_password: "your_app_password"

mailing_groups:
  - name: "Group1"
    recipients: ["user1@example.com", "user2@example.com"]
    categories: ["CategoryA", "CategoryB"]
  - name: "Group2"
    recipients: ["admin@example.com"]
    categories: ["CategoryB"]

settings:
  schedule_time: "08:00"
  max_news_per_category: 5
  sources: ["naver", "google", "daum"]
  deduplicate: true
  dynamic_keywords: true
